# Public configuration. Obtain these values from your own LINE and Supabase consoles.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
NEXT_PUBLIC_LINE_LIFF_ID=replace_with_liff_id

# Server-only credentials. Never prefix these with NEXT_PUBLIC_ or commit real values.
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key
LINE_LOGIN_CHANNEL_ID=replace_with_line_login_channel_id

# Optional Ticket 09: keep off until LINE webhook and Gemini credentials are configured.
LINE_MESSAGING_CHANNEL_SECRET=replace_with_messaging_api_channel_secret
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=replace_with_messaging_api_access_token
LINE_CHAT_ENABLED=false
GEMINI_API_KEY=replace_with_gemini_api_key
# Optional primary must be one of the two stable Lite models; the other is the capacity fallback.
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional Ticket 10: configure a long random value in Vercel before enabling.
FEEDBACK_ENABLED=false
CRON_SECRET=replace_with_long_random_cron_secret

# Required in production for same-origin checks, e.g. https://app.example.com
APP_ORIGIN=http://localhost:3000
