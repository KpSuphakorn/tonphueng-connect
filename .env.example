# Public configuration. Obtain these values from your own LINE and Supabase consoles.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
NEXT_PUBLIC_LINE_LIFF_ID=replace_with_liff_id

# Server-only credentials. Never prefix these with NEXT_PUBLIC_ or commit real values.
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key
LINE_LOGIN_CHANNEL_ID=replace_with_line_login_channel_id

# Required in production for same-origin checks, e.g. https://app.example.com
APP_ORIGIN=http://localhost:3000
